<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="ISPDBConnectionString"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ISPManagement;Integrated Security=True;TrustServerCertificate=True" />
  </connectionStrings>
  <appSettings>
    <add key="CompanyName" value="AB Flash Fiber"/>
    <add key="CompanyNumber" value="0300000000"/>
    <add key="LateFee" value="500"/>
    
  </appSettings>
</configuration>